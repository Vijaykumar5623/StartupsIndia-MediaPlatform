# =============================================================================
# StartupsIndia — Example environment / build-time configuration
# =============================================================================
#
# IMPORTANT: This app does NOT read a .env file at runtime.
# Configuration is passed to Flutter at build time via --dart-define and is
# read in lib/core/config/app_config.dart.
#
# This file exists as a reference for which values are configurable and what
# safe placeholder values look like. Copy it to `.env` for your own notes if
# you like (`.env` is gitignored). NEVER commit real secrets.
#
# To apply these at build/run time, pass them as --dart-define flags, e.g.:
#   flutter run --dart-define=ENV=development
#   flutter build appbundle --release --dart-define=ENV=prod
# -----------------------------------------------------------------------------

# App environment. Read by AppConfig.environment. Use `development` locally,
# `prod` for release builds (CI passes --dart-define=ENV=prod).
ENV=development

# Cloudinary (image uploads). These are CLIENT-SIDE values by design — the
# unsigned upload preset is meant to be shipped in the app. They are NOT secret
# keys, but the preset MUST be restricted in the Cloudinary console (allowed
# formats, max size, dedicated folder) before launch. See docs/configuration.md.
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_UPLOAD_PRESET=your_unsigned_upload_preset

# -----------------------------------------------------------------------------
# NOT stored here — provisioned through the platform, never in the repo:
#   - android/app/google-services.json   (Firebase Android config; gitignored)
#   - android/key.properties + *.jks      (release signing; gitignored)
#   - Firebase Admin SDK service account  (serviceAccount.json; gitignored)
# See SECURITY.md and docs/configuration.md for how these are handled.
# -----------------------------------------------------------------------------
